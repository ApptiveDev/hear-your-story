SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

POSTGRES_DB=apptive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/apptive
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 32바이트 이상의 임의 문자열. 실제 값은 커밋하지 않는다.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ACCESS_TOKEN_EXPIRATION_MINUTES=30
APP_REGISTRATION_TOKEN_EXPIRATION_MINUTES=10
APP_REFRESH_TOKEN_EXPIRATION_DAYS=30
KAKAO_NATIVE_APP_KEY=
# 카카오디벨로퍼스 Admin Key. 실제 값은 저장소에 커밋하지 않는다.
KAKAO_ADMIN_KEY=

AUDIO_PROCESSING_MODE=mock
PROCESSING_RECOVERY_ENABLED=true
PROCESSING_RECOVERY_STALE_AFTER=5m
PROCESSING_RECOVERY_INITIAL_DELAY=10s
PROCESSING_RECOVERY_FIXED_DELAY=1m
PROCESSING_RECOVERY_BATCH_SIZE=50
ACCOUNT_DELETION_INITIAL_DELAY=10s
ACCOUNT_DELETION_FIXED_DELAY=1m
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_CONNECT_TIMEOUT=10s
OPENAI_READ_TIMEOUT=90s

STORAGE_TYPE=local
LOCAL_STORAGE_DIRECTORY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_DURATION=15m

JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate
